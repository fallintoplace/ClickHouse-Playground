{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": [],
    "rootDir": ".",
    "outDir": ".workspace-build",
    "noEmitOnError": true
  },
  "include": [
    "src/frontend/queries/editor/drafts/workspace-state.ts",
    "src/frontend/assistant/chat/assistant-chat-state.ts",
    "src/frontend/workspace/layout/workspace-layout.ts",
    "src/frontend/queries/editor/drafts/workspace-persistence.ts",
    "src/frontend/queries/results/statement-outcome.ts",
    "src/frontend/workspace/layout/notifications/workspace-notification-policy.ts",
    "src/frontend/queries/editor/sql-error.ts",
    "src/frontend/queries/results/result-provenance.ts",
    "src/frontend/browser/visible-polling.ts",
    "src/frontend/api/browser-workspace.ts",
    "src/frontend/database/imports/state/cloud-import.ts",
    "src/frontend/help/examples/sql-examples.ts",
    "src/frontend/help/workspace-help-model.ts",
    "src/frontend/queries/results/charts/controls/chart-selection.ts",
    "src/frontend/queries/results/charts/rendering/chart-view-model.ts",
    "src/frontend/queries/history/evidence.ts",
    "src/frontend/queries/saved-queries/draft-save.ts",
    "src/frontend/database/explorer/objects/model.ts",
    "src/shared/database/tables/delete-table.ts",
    "src/shared/database/reference/reference.ts",
    "src/frontend/help/reference/reference-data.ts",
    "src/frontend/ui/copy.ts",
    "src/frontend/queries/editor/schema-context.ts",
    "src/frontend/queries/editor/components/editor-session.ts"
  ]
}
