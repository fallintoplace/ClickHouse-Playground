{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "outDir": ".core-build"
  },
  "include": [
    "src/shared",
    "src/backend/queries/saved-queries/documents.ts",
    "src/backend/assistant/evaluation.ts",
    "src/backend/assistant/context/input-validation.ts",
    "src/backend/assistant/proposals/assistant.ts",
    "src/backend/database/clickhouse/query-format.ts",
    "src/backend/database/clickhouse/result-stream.ts",
    "src/backend/system/requests/errors.ts",
    "src/backend/queries/execution/guards.ts",
    "src/shared/database/imports/mapping.ts",
    "src/backend/database/imports/imports.ts",
    "src/backend/database/imports/cloud-query-log-outcome.ts",
    "src/backend/queries/monitoring/monitors.ts",
    "src/backend/queries/execution/runs.ts",
    "src/backend/system/login/sessions.ts",
    "src/backend/system/store.ts",
    "src/backend/database/tables/create-table.ts",
    "src/backend/database/tables/delete-table.ts",
    "src/backend/database/databases/delete-database.ts",
    "src/backend/database/tables/permissions.ts",
    "src/backend/database/functions/sql-functions.ts",
    "src/backend/database/functions/executable-functions.ts",
    "src/backend/system/requests/validation.ts",
    "src/frontend/assistant/proposals/assistant-proposal-parser.ts",
    "src/frontend/database/connections/selection.ts",
    "src/frontend/queries/editor/sql-editor-helpers.ts",
    "src/frontend/queries/history/query-parameter-comparison.ts",
    "src/frontend/queries/inspection/performance/explain-analyze.ts",
    "src/frontend/queries/inspection/plans/explain-indexes.ts",
    "src/frontend/queries/results/maps/geo.ts",
    "src/frontend/queries/results/maps/geo-projection.ts",
    "src/frontend/queries/editor/parser/native-ast.ts",
    "src/frontend/database/explorer/native-value-formatters.ts",
    "src/frontend/database/explorer/objects/object-explorer-model.ts",
    "src/frontend/database/connections/playground-value-decoder.ts",
    "src/frontend/queries/inspection/diagrams/query-tree-parser.ts",
    "src/frontend/queries/history/run-comparison.ts",
    "src/frontend/queries/execution/execution-validation.ts",
    "src/frontend/ui/components/tree-model.ts",
    "src/frontend/queries/saved-queries/draft-save-state.ts",
    "src/backend/system/config.ts",
    "src/backend/database/clickhouse/sample-client.ts"
  ]
}
