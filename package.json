{
  "name": "clickstudio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm --prefix clickstudio ci",
    "dev": "npm --prefix clickstudio run dev",
    "start": "npm --prefix clickstudio start",
    "start:production": "npm --prefix clickstudio run start:production",
    "build": "npm --prefix clickstudio run build",
    "typecheck": "npm --prefix clickstudio run typecheck",
    "test": "npm --prefix clickstudio test",
    "test:integration": "npm --prefix clickstudio run test:integration",
    "test:e2e": "npm --prefix clickstudio run test:e2e",
    "coverage": "npm --prefix clickstudio run coverage",
    "bench": "npm --prefix clickstudio run bench --",
    "bench:test": "npm --prefix clickstudio run bench:test",
    "bench:compare": "npm --prefix clickstudio run bench:compare --",
    "review": "npm --prefix clickstudio run review",
    "check": "npm --prefix clickstudio run check"
  }
}
